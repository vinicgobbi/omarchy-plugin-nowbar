#!/bin/bash

# Lets the Now Bar take the place of Omarchy's indicators widget, and puts it
# back. Run by the "Replace" / "Restore" buttons in the Now Bar (options and
# popup), or by hand:
#
#   nowbar-indicators replace   # turn omarchy.indicators off (its place in the bar is remembered)
#   nowbar-indicators restore   # turn it back on, where it was
#   nowbar-indicators status    # prints "replaced" or "native" ("unknown", exit 3, if the shell doesn't answer)
#
# Nothing here needs sudo. The widget's place is kept in
# ~/.local/state/vinicgobbi.nowbar/omarchy.indicators.place.

set -euo pipefail

id="omarchy.indicators"
shell_json="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/vinicgobbi.nowbar"
place_file="$state_dir/$id.place"

# The plugin list comes from the running shell over IPC; while the shell is
# starting it may not answer. Exits 3 then, so nothing is decided on a guess.
plugins_json() {
  local json
  json=$(omarchy plugin list --json 2>/dev/null) || exit 3
  jq -e 'type == "array" and length > 0' >/dev/null 2>&1 <<<"$json" || exit 3
  printf '%s' "$json"
}

enabled() {
  local json
  json=$(plugins_json) || exit 3
  jq -e --arg id "$id" 'any(.[]; .id == $id and .enabled)' >/dev/null <<<"$json"
}

# "<section> <index>" of the widget in the bar, or nothing.
current_place() {
  [[ -f $shell_json ]] || return 0
  jq -r --arg id "$id" '
    .bar.layout // {} | to_entries[] | .key as $section | .value
    | to_entries[] | select((.value | if type == "object" then .id else . end) == $id)
    | "\($section) \(.key)"' "$shell_json" 2>/dev/null | head -n1
}

case ${1:-} in
replace)
  if enabled; then
    place=$(current_place)
    if [[ -n $place ]]; then
      mkdir -p "$state_dir"
      printf '%s\n' "$place" >"$place_file"
    fi
    omarchy plugin disable "$id" >/dev/null
  fi
  echo "replaced"
  ;;
restore)
  if ! enabled; then
    section="" index=""
    [[ -f $place_file ]] && read -r section index <"$place_file" || true
    if [[ $section =~ ^(left|center|right)$ && $index =~ ^[0-9]+$ ]]; then
      omarchy plugin enable "$id" --section "$section" --index "$index" >/dev/null
    else
      omarchy plugin enable "$id" >/dev/null
    fi
    rm -f -- "$place_file"
  fi
  echo "native"
  ;;
status)
  json=$(plugins_json) || { echo "unknown"; exit 3; }
  if jq -e --arg id "$id" 'any(.[]; .id == $id and .enabled)' >/dev/null <<<"$json"; then echo "native"; else echo "replaced"; fi
  ;;
*)
  echo "Usage: nowbar-indicators replace|restore|status" >&2
  exit 2
  ;;
esac
