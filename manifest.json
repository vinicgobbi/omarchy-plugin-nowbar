{
  "schemaVersion": 1,
  "id": "vinicgobbi.nowbar",
  "name": "Now Bar",
  "version": "0.4.0",
  "author": "vinicgobbi",
  "license": "MIT",
  "homepage": "https://github.com/vinicgobbi/omarchy-plugin-nowbar",
  "description": "Samsung-style Now Bar: one pill in the bar for what's going on right now (media players, timer, stopwatch, Pomodoro, sleep timer, reminders, screen recording, dictation, camera/mic in use, modes and VPN, charging and low battery, Bluetooth, screenshots, and live updates from scripts), with a Now Brief when nothing is. Scroll to switch, click for the details.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "omarchy": {
    "clonedFrom": "omarchy.media"
  },
  "barWidget": {
    "displayName": "Now Bar",
    "description": "Pill with the current live activity: scroll to switch, left click for the details, middle click for the main action",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "rigth",
    "defaults": {
      "moduleMedia": true,
      "moduleTimer": true,
      "moduleReminders": true,
      "moduleRecording": true,
      "moduleDictation": true,
      "modulePrivacy": true,
      "moduleModes": true,
      "moduleCharging": true,
      "modulePush": true,
      "moduleBluetooth": true,
      "moduleScreenshot": true,
      "moduleWeather": true,
      "weatherUnit": "auto",
      "autoFocus": true,
      "coverAccent": true,
      "whenEmpty": "brief",
      "showProgress": true,
      "showCount": true,
      "showQuickToggles": true,
      "quickToggleItems": "dnd,nightlight,stayAwake,record,reminder,dictation",
      "showQuickStart": true,
      "quickStartItems": "stopwatch,pomodoro,sleep",
      "textMode": "scroll",
      "maxWidth": 220,
      "timerPresets": "1,5,10,25",
      "pomodoroFocus": 25,
      "pomodoroBreak": 5,
      "pomodoroLongBreak": 15
    },
    "schema": [
      {
        "key": "moduleMedia",
        "type": "boolean",
        "label": "Media",
        "description": "What's playing (MPRIS), with play/pause, previous and next.",
        "defaultValue": true
      },
      {
        "key": "moduleTimer",
        "type": "boolean",
        "label": "Timer and stopwatch",
        "defaultValue": true
      },
      {
        "key": "moduleReminders",
        "type": "boolean",
        "label": "Reminders",
        "description": "Countdown to the next omarchy-reminder.",
        "defaultValue": true
      },
      {
        "key": "moduleRecording",
        "type": "boolean",
        "label": "Screen recording",
        "defaultValue": true
      },
      {
        "key": "moduleDictation",
        "type": "boolean",
        "label": "Dictation",
        "description": "Voxtype listening / transcribing.",
        "defaultValue": true
      },
      {
        "key": "modulePrivacy",
        "type": "boolean",
        "label": "Camera and microphone in use",
        "defaultValue": true
      },
      {
        "key": "moduleModes",
        "type": "boolean",
        "label": "Modes",
        "description": "Do Not Disturb, stay awake and night light, while on.",
        "defaultValue": true
      },
      {
        "key": "moduleCharging",
        "type": "boolean",
        "label": "Charging",
        "defaultValue": true
      },
      {
        "key": "modulePush",
        "type": "boolean",
        "label": "Live updates from scripts",
        "description": "Activities sent with `omarchy-shell nowbar push`.",
        "defaultValue": true
      },
      {
        "key": "moduleBluetooth",
        "type": "boolean",
        "label": "Bluetooth device connected",
        "description": "Shows for a few seconds, with its battery.",
        "defaultValue": true
      },
      {
        "key": "moduleScreenshot",
        "type": "boolean",
        "label": "Screenshot taken",
        "description": "Shows for a few seconds, with edit, copy and open. Needs inotify-tools.",
        "defaultValue": true
      },
      {
        "key": "moduleWeather",
        "type": "boolean",
        "label": "Weather",
        "description": "Weather card (wttr.in, Omarchy's saved location): the Now Brief.",
        "defaultValue": true
      },
      {
        "key": "weatherUnit",
        "type": "enum",
        "label": "Temperature",
        "options": [
          "auto",
          "metric",
          "imperial"
        ],
        "description": "auto: °F in the US (and Liberia, Myanmar), else °C.",
        "defaultValue": "auto"
      },
      {
        "key": "autoFocus",
        "type": "boolean",
        "label": "Focus new activities",
        "defaultValue": true
      },
      {
        "key": "coverAccent",
        "type": "boolean",
        "label": "Dynamic colors",
        "description": "Media takes its colors from the album cover and weather from the sky: the highlight, the popup's border and a tint of its background.",
        "defaultValue": true
      },
      {
        "key": "whenEmpty",
        "type": "enum",
        "label": "When nothing is going on",
        "options": [
          "brief",
          "icon",
          "hide"
        ],
        "defaultValue": "brief",
        "description": "brief: the weather card (with an Omarchy update notice); icon: an empty pill; hide: no pill."
      },
      {
        "key": "showProgress",
        "type": "boolean",
        "label": "Progress line",
        "defaultValue": true
      },
      {
        "key": "showCount",
        "type": "boolean",
        "label": "Position (2/4)",
        "defaultValue": true
      },
      {
        "key": "showQuickToggles",
        "type": "boolean",
        "label": "Quick toggles",
        "description": "Do Not Disturb, night light, stay awake, screen recording, reminder and dictation buttons in the popup.",
        "defaultValue": true
      },
      {
        "key": "quickToggleItems",
        "type": "string",
        "label": "Quick toggles shown",
        "description": "Comma separated: dnd, nightlight, stayAwake, record, reminder, dictation. Empty: none.",
        "defaultValue": "dnd,nightlight,stayAwake,record,reminder,dictation"
      },
      {
        "key": "showQuickStart",
        "type": "boolean",
        "label": "Quick start",
        "description": "Timers, stopwatch, Pomodoro and the media sleep timer in the popup.",
        "defaultValue": true
      },
      {
        "key": "quickStartItems",
        "type": "string",
        "label": "Quick start extras",
        "description": "Comma separated: stopwatch, pomodoro, sleep. Empty: none.",
        "defaultValue": "stopwatch,pomodoro,sleep"
      },
      {
        "key": "textMode",
        "type": "enum",
        "label": "Long text",
        "description": "Text longer than the pill: scroll it, or cut it with \"...\".",
        "options": [
          "scroll",
          "ellipsis"
        ],
        "defaultValue": "scroll"
      },
      {
        "key": "maxWidth",
        "type": "integer",
        "label": "Pill text width (px)",
        "min": 80,
        "max": 600,
        "step": 20,
        "defaultValue": 220,
        "description": "The pill always keeps this size."
      },
      {
        "key": "timerPresets",
        "type": "string",
        "label": "Quick start timers",
        "description": "Minutes, separated by commas (up to 6).",
        "defaultValue": "1,5,10,25"
      },
      {
        "key": "pomodoroFocus",
        "type": "integer",
        "label": "Pomodoro focus (min)",
        "min": 1,
        "max": 180,
        "step": 5,
        "defaultValue": 25
      },
      {
        "key": "pomodoroBreak",
        "type": "integer",
        "label": "Pomodoro break (min)",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "pomodoroLongBreak",
        "type": "integer",
        "label": "Pomodoro long break (min)",
        "min": 1,
        "max": 120,
        "step": 5,
        "defaultValue": 15
      }
    ]
  }
}
